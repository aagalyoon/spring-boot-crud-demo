{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Items API",
      "type": "shell",
      "command": "mvn",
      "args": ["spring-boot:run"],
      "dependsOn": ["Stop Items API"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "/opt/homebrew/opt/openjdk@17"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Stop Items API",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/demo.sh",
      "args": ["stop"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Clean Demo Runtime",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/demo.sh",
      "args": ["clean"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Test Items API",
      "type": "shell",
      "command": "mvn",
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "/opt/homebrew/opt/openjdk@17"
        }
      },
      "problemMatcher": []
    }
  ]
}
